package components

import "github.com/deej-tsn/compSudoku/internal/models"
import "fmt"

templ Square(square models.Square) {
    if square.Active {
        if square.Value > 0{
             <div id="activeSquare" class="square isActive" hx-post="/sudoku/active" hx-vals={fmt.Sprintf("{ \"value\" : \"%d\"", square.Value)} hx-swap="outerHTML" hx-target="#grid" hx-trigger="click, newValue"> 
                {fmt.Sprintf("%d",square.Value)}
            </div>
        }else{
            <div id="activeSquare" class="square isActive" hx-post="/sudoku/active" hx-vals="js:{value:event.detail.lastKey}" hx-swap="outerHTML" hx-target="#grid" hx-trigger="click, newValue"> 
            </div>
        }

    } else{
        <div class={"square", templ.KV("isRelated", square.RelatedToActive), templ.KV("isSameValue", square.SameValueToActive)} hx-post="/sudoku" hx-vals={fmt.Sprintf("{ \"value\" : \"%d\" , \"position\" : \"%d,%d\"}",square.Value,square.RowIndex,square.ColumnIndex) } hx-swap="outerHTML" hx-target="#grid" hx-trigger="click"> 
            if square.Value > 0 {
                {fmt.Sprintf("%d",square.Value)}
            }
        </div>

    }

}