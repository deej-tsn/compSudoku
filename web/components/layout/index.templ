package components


import "github.com/deej-tsn/compSudoku/internal/models"


templ Index(Title string, game *models.Game, chat *models.ChatLog) {
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{Title}</title>
        <link rel="icon" type="image/x-icon" href="/static/assets/favicon.ico">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/normalize/8.0.1/normalize.min.css">
        <link rel="stylesheet" href="/static/css/style.css">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap" rel="stylesheet">
        <script src="https://unpkg.com/htmx.org"></script>
        <script src="https://unpkg.com/htmx-ext-ws@2.0.1/ws.js"></script>
        <script src="https://unpkg.com/htmx.org/dist/ext/json-enc.js"></script>

        <script src="https://kit.fontawesome.com/9544cb5fae.js" crossorigin="anonymous"></script>

    </head>
    <body>
        @Content(game, chat)

    </body>
    <script type="text/javascript">
        let activeSquareEventHandler = (event) => {
            let activeSquare = document.getElementById("activeSquare")
            if(event.which >= 48 && event.which <= 57){
                htmx.trigger("#activeSquare", "newValue", {lastKey : event.key})
            }
        };

        let body = document.querySelector("body")

        body.addEventListener("keydown", activeSquareEventHandler)
        

    </script>
    </html>
}