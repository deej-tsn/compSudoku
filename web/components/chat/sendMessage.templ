package components

templ SendMessage() {
    <form id="sendMessage" hx-trigger="submit" ws-send data-ws="chat_message" hx-on:submit="this.reset()" hx-ext="ws, wsFormJSON">
        <input id="messageContent" name="message" type="text" placeholder="send message"/>
        <button type="submit" id="messageButton"> > </button>
    </form>
}